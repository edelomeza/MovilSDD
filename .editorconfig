root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 160

[*.kt]
ij_kotlin_code_style = official
ktlint_code_style = android_studio
# Naming de Composables lo cubre Detekt (ignoreAnnotated Composable/Preview)
ktlint_standard_function-naming = disabled

[*.kts]
ij_kotlin_code_style = official
